{
    "name": "pearlcon/rail-services",
    "type": "project",
    "description": "Pearlcon Rail Services Ltd — Global Railway Procurement, Sourcing & Engineering Solutions",
    "keywords": ["railway", "procurement", "rail", "supply-chain", "laravel"],
    "license": "proprietary",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "laravel/framework": "^10.0 || ^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0 || ^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
